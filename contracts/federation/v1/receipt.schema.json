{
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "authority_node_id": {
      "type": "string",
      "format": "uuid"
    },
    "channel_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "state": {
      "enum": [
        "message_committed",
        "requested",
        "accepted",
        "running",
        "completed",
        "rejected",
        "cancel_requested",
        "cancelled",
        "unknown"
      ]
    },
    "process_state": {
      "enum": [
        "not_applicable",
        "not_started",
        "unknown",
        "running",
        "finished",
        "stopped"
      ]
    }
  },
  "required": [
    "protocol_version",
    "request_id",
    "authority_node_id",
    "channel_id",
    "event_id",
    "seq",
    "revision",
    "state",
    "process_state"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anygarden:federation:v1:receipt"
}
