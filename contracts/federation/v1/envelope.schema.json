{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anygarden:federation:v1:command",
  "$defs": {
    "principal": {
      "type": "object",
      "properties": {
        "node_id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "enum": [
            "agent",
            "human"
          ]
        },
        "principal_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "node_id",
        "kind",
        "principal_id"
      ],
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "properties": {
        "node_id": {
          "type": "string",
          "format": "uuid"
        },
        "agent_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "node_id",
        "agent_id"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "sender_node_id": {
          "type": "string",
          "format": "uuid"
        },
        "authority_node_id": {
          "type": "string",
          "format": "uuid"
        },
        "channel_id": {
          "type": "string",
          "format": "uuid"
        },
        "grant_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "actor": {
          "$ref": "#/$defs/principal"
        },
        "kind": {
          "const": "message.send"
        },
        "payload": {
          "type": "object",
          "properties": {
            "message_id": {
              "type": "string",
              "format": "uuid"
            },
            "thread_root_id": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            }
          },
          "required": [
            "message_id",
            "thread_root_id",
            "text"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocol_version",
        "request_id",
        "sender_node_id",
        "authority_node_id",
        "channel_id",
        "grant_epoch",
        "actor",
        "kind",
        "payload"
      ],
      "additionalProperties": false
    },
